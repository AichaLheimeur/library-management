    {
      "name": "Users (admin)",
      "item": [
        {
          "name": "Get All Users",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "if (Array.isArray(json) && json.length > 0) {",
                  "  const user = json.find(u => u.role === 'USER');",
                  "  if (user) {",
                  "    pm.collectionVariables.set('user_id', user.id);",
                  "    console.log('user_id saved:', user.id);",
                  "  }",
                  "}"
                ],
                "type": "text/javascript"
              }
