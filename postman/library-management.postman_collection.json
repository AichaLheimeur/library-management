        {
          "name": "Get My Loans",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "if (Array.isArray(json) && json.length > 0) {",
                  "  const activeLoan = json.find(l => l.status === 'BORROWED');",
                  "  if (activeLoan) {",
                  "    pm.collectionVariables.set('loan_id', activeLoan.id);",
                  "    console.log('loan_id saved:', activeLoan.id);",
                  "  }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
